[Unit]
Description=Private Persona phone console (SSH tunnel only)
After=network-online.target asterisk.service
Requires=asterisk.service

[Service]
User=asterisk
Group=asterisk
WorkingDirectory=/opt/persona-phone-console
EnvironmentFile=/etc/persona-phone-console.env
ExecStart=/usr/bin/python3 /opt/persona-phone-console/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
