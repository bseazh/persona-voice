[Unit]
Description=Persona Voice LiveKit Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Project/persona-voice
EnvironmentFile=/home/ubuntu/Project/persona-voice/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/Project/persona-voice/.venv-agent/bin/python /home/ubuntu/Project/persona-voice/services/agent/agent.py start
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
