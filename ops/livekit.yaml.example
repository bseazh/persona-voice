# Credentials are generated on the server in /etc/persona-livekit/livekit.yaml.
port: 7880
rtc:
  tcp_port: 5052
  udp_port: 5053
  use_external_ip: false
  node_ip: 134.175.154.244
  advertise_internal_ip: true
  interfaces:
    includes:
      - eth0
