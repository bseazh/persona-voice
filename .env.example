# Public mock deployment (safe default)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_PATH=/app/data/calls.db
WEB_ORIGIN=http://localhost:3000
MOCK_STEP_DELAY_SECONDS=0.8

# Real calling is rejected unless all safeguards are configured.
ENABLE_REAL_CALLS=false
ALLOWED_DESTINATION_NUMBERS=+17025550123
MAX_CONCURRENT_CALLS=1
MAX_CALL_DURATION_SECONDS=180
ENABLE_TRANSCRIPT_STORAGE=false
ENABLE_RECORDING=false

# LiveKit and AI providers (server-side only; never expose to Next.js)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
SIP_OUTBOUND_TRUNK_ID=ST_REPLACE_ME
OPENAI_API_KEY=REPLACE_ME
DEEPGRAM_API_KEY=REPLACE_ME
CARTESIA_API_KEY=REPLACE_ME
STT_MODEL=nova-3
STT_LANGUAGE=zh-CN
LLM_MODEL=gpt-4o-mini
TTS_MODEL=sonic-3
TTS_VOICE_ID=REPLACE_ME

