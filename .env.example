# LiveKit Cloud (server-side only)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
LIVEKIT_AGENT_NAME=persona-voice-agent

# Required in production. Users enter this before a paid Agent session is created.
VOICE_ACCESS_CODE=REPLACE_WITH_A_LONG_RANDOM_VALUE

# ElevenLabs real-time speech
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
STT_PROVIDER=elevenlabs
STT_MODEL=scribe_v2_realtime
STT_LANGUAGE=zh
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_v4
TTS_VOICE_ID=REPLACE_ME

# DeepSeek conversation model
DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# Runtime
LOG_LEVEL=INFO
