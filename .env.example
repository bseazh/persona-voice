# Self-hosted LiveKit (server-side only); a Cloud URL is also supported.
LIVEKIT_URL=wss://YOUR_DOMAIN/livekit
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
LIVEKIT_AGENT_NAME=persona-voice-agent

# Required in production. Users enter this before a paid Agent session is created.
VOICE_ACCESS_CODE=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Qwen speech (Beijing workspace)
STT_PROVIDER=qwen
STT_MODEL=qwen-audio-3.1-asr-flash
DASHSCOPE_API_KEY=REPLACE_ME
# Optional separate TTS credential; ASR continues using DASHSCOPE_API_KEY.
DASHSCOPE_TTS_API_KEY=
DASHSCOPE_TTS_WORKSPACE=
LIVEKIT_AGENT_IDLE_PROCESSES=1
QWEN_ASR_URL=https://YOUR_ENDPOINT/api/v1/services/aigc/multimodal-generation/generation
QWEN_ASR_MODEL=qwen-audio-3.1-asr-flash
STT_LANGUAGE=zh
TTS_PROVIDER=qwen
TTS_MODEL=qwen-audio-3.1-tts-flash
DASHSCOPE_WORKSPACE=YOUR_WORKSPACE_ID
QWEN_TTS_MODEL=qwen-audio-3.1-tts-flash
QWEN_TTS_VOICE=longanhuan_v3.1

# DeepSeek conversation model
DEEPSEEK_API_KEY=REPLACE_ME
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# Runtime
LOG_LEVEL=INFO
ASR_MODE=streaming
QWEN_STREAMING_ASR_MODEL=qwen-audio-3.1-asr-flash-streaming
